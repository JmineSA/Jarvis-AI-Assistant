# Copy this file to .env and edit. .env is git-ignored; never commit secrets.
# Every value is optional: anything omitted falls back to config/settings.yaml.

# Path to an alternative settings file
# JARVIS_CONFIG=config/settings.yaml

# Ollama
# JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
# JARVIS_OLLAMA_MODEL=qwen2.5:3b-instruct
# JARVIS_OLLAMA_TIMEOUT=120

# API server (keep it on 127.0.0.1 so only this computer can reach it)
# JARVIS_API_HOST=127.0.0.1
# JARVIS_API_PORT=8000

# Voice
# JARVIS_PTT_KEY=right_ctrl
# JARVIS_INPUT_DEVICE=Microphone
# JARVIS_OUTPUT_DEVICE=Speakers
# JARVIS_STT_MODEL=small.en
# JARVIS_TTS_VOICE=en_GB-alan-medium

# Logging
# JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_DIR=logs
